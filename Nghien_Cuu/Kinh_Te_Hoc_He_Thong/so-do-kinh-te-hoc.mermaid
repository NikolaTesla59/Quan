    classDef root fill:#1e293b,stroke:#0f172a,color:#ffffff,font-weight:bold
    classDef micro fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e
    classDef market fill:#fef3c7,stroke:#b45309,color:#78350f
    classDef failure fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d
    classDef trade fill:#dcfce7,stroke:#15803d,color:#14532d
    classDef strategy fill:#ede9fe,stroke:#6d28d9,color:#4c1d95
    classDef behavioral fill:#fce7f3,stroke:#be185d,color:#831843
    classDef macro fill:#e5e7eb,stroke:#374151,color:#111827

    class ROOT root
    class B1,B1a,B1b,B1c,B1d micro
    class B2,B2a,B2b,B2c market
    class B3,B3a,B3b,B3c,B3d failure
    class B4,B4a,B4b,B4c,B4d trade
